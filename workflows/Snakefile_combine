            2>&1 | tee -a {log}
        echo "[$(date)] Completed convert_coffea_to_json_incl3j2b" >> {log}
        """


# ── Step 2: JSON → ROOT shapes + per-year datacards  [combine container] ──────
rule make_combine_inputs:
    retries: 2
    input:
        nominal   = f"{OUT}/histAll_nominal.json",
        lowpt     = f"{OUT}/histAll_lowpt.json",
        incl3j2b  = f"{OUT}/histAll_incl3j2b.json",
    output:
        nominal_card  = f"{DCARDS}/datacard_nominal.txt",
        lowpt_card    = f"{DCARDS}/datacard_lowpt.txt",
        incl3j2b_card = f"{DCARDS}/datacard_incl3j2b.txt",
        combined      = f"{DCARDS}/datacard_combined.txt",
    log:
        f"{OUT}/logs/make_combine_inputs.log"
    params:
        dcards = DCARDS,
        merge_years_flag = MERGE_YEARS_FLAG,
    shell:
        """
        mkdir -p $(dirname {log})
        rm -rf {params.dcards}
        echo "[$(date)] Starting make_combine_inputs (nominal)" > {log}
        {config[combine_wrapper]} \
            python3 bbreww/stats_analysis/make_combine_inputs.py \
                --var {config[nominal_variable]} \
                -f {input.nominal} \
                -o {params.dcards}/nominal \
                --rebin {config[rebin]} \
                --metadata bbreww/stats_analysis/metadata/bbWW.yml \
                --stat_only {params.merge_years_flag} \
            2>&1 | tee -a {log}

        echo "[$(date)] Starting make_combine_inputs (lowpt)" >> {log}
        {config[combine_wrapper]} \
            python3 bbreww/stats_analysis/make_combine_inputs.py \
                --var {config[lowpt_variable]} \
                -f {input.lowpt} \
                -o {params.dcards}/lowpt \
                --rebin {config[rebin]} \
                --metadata bbreww/stats_analysis/metadata/bbWW.yml \
                --stat_only {params.merge_years_flag} \
            2>&1 | tee -a {log}

        echo "[$(date)] Starting make_combine_inputs (incl3j2b)" >> {log}
        {config[combine_wrapper]} \
            python3 bbreww/stats_analysis/make_combine_inputs.py \
                --var {config[incl3j2b_variable]} \
                -f {input.incl3j2b} \
                -o {params.dcards}/incl3j2b \
                --rebin {config[rebin]} \
                --metadata bbreww/stats_analysis/metadata/bbWW.yml \
                --stat_only {params.merge_years_flag} \
            2>&1 | tee -a {log}

        echo "[$(date)] Building per-category and combined datacards" >> {log}
        {config[combine_wrapper]} "cd {params.dcards} && \
            nominal_args=\\$(for f in nominal/datacard_*.txt; do \
                bn=\\$(basename \\$f .txt | sed 's/^datacard_/nominal_/'); \
                echo -n \\\"\\$bn=\\$f \\\"; done) && \
            lowpt_args=\\$(for f in lowpt/datacard_*.txt; do \
                bn=\\$(basename \\$f .txt | sed 's/^datacard_/lowpt_/'); \
                echo -n \\\"\\$bn=\\$f \\\"; done) && \
            incl3j2b_args=\\$(for f in incl3j2b/datacard_*.txt; do \
                bn=\\$(basename \\$f .txt | sed 's/^datacard_/incl3j2b_/'); \
                echo -n \\\"\\$bn=\\$f \\\"; done) && \
            combineCards.py \\$nominal_args  > datacard_nominal.txt  && \
            combineCards.py \\$lowpt_args    > datacard_lowpt.txt    && \
            combineCards.py \\$incl3j2b_args > datacard_incl3j2b.txt && \
            combineCards.py \\$nominal_args \\$lowpt_args \\$incl3j2b_args > datacard_combined.txt" \
            2>&1 | tee -a {log}

        echo "[$(date)] Completed make_combine_inputs" >> {log}
        """


# ── Step 3+4: workspace + AsymptoticLimits per category  [combine container] ──
rule limits_per_category:
    retries: 2
    input:
        f"{DCARDS}/datacard_{{cat}}.txt"
    output:
        ws       = f"{DCARDS}/datacard_{{cat}}.root",
        txt      = f"{DCARDS}/limits_{{cat}}.txt",
        hc_root  = f"{DCARDS}/higgsCombine_{{cat}}.AsymptoticLimits.mH120.root",
    log:
        f"{OUT}/logs/limits_{{cat}}.log"
    params:
        dcards = DCARDS,
    shell:
        """
        mkdir -p $(dirname {log})
        echo "[$(date)] Building workspace for {wildcards.cat}" > {log}
        {config[combine_wrapper]} "cd {params.dcards} && \
            text2workspace.py datacard_{wildcards.cat}.txt \
            -o datacard_{wildcards.cat}.root" \
            2>&1 | tee -a {log}

        echo "[$(date)] Running AsymptoticLimits for {wildcards.cat}" >> {log}
        {config[combine_wrapper]} "cd {params.dcards} && \
            combine -M AsymptoticLimits datacard_{wildcards.cat}.root \
            --run blind \
            -n _{wildcards.cat}" \
            > {output.txt} 2>&1
        cat {output.txt} >> {log}
        """


# ── Step 5: collect each category's limit ROOT into JSON ─────────────────────
# combineTool.py -M CollectLimits emits the {'120.0': {obs, exp0, exp±1, exp±2}}
# structure that coffea4bees/plots/make_limit_plot.py expects.
rule collect_limit_json:
    retries: 2
    input:
        f"{DCARDS}/higgsCombine_{{cat}}.AsymptoticLimits.mH120.root"
    output:
        f"{DCARDS}/limits_{{cat}}.json"
    log:
        f"{OUT}/logs/collect_limit_json_{{cat}}.log"
    params:
        dcards = DCARDS,
    shell:
        """
        mkdir -p $(dirname {log})
        echo "[$(date)] CollectLimits for {wildcards.cat}" > {log}
        {config[combine_wrapper]} "cd {params.dcards} && \
            combineTool.py -M CollectLimits \
                higgsCombine_{wildcards.cat}.AsymptoticLimits.mH120.root \
                -o limits_{wildcards.cat}.json" \
            2>&1 | tee -a {log}
        """


# ── Step 6: summary — extract Brazil bands and print side-by-side ─────────────
rule summary:
    retries: 2
    input:
        nominal  = f"{DCARDS}/limits_nominal.txt",
        lowpt    = f"{DCARDS}/limits_lowpt.txt",
        incl3j2b = f"{DCARDS}/limits_incl3j2b.txt",
        combined = f"{DCARDS}/limits_combined.txt",
    output:
        f"{OUT}/summary.txt"
    params:
        dcards = DCARDS,
    shell:
        r"""
        {{
        echo "============================================================"
        echo " bbWW expected 95% CL upper limits on r (signal strength) "
        echo "============================================================"
        for cat in nominal lowpt incl3j2b combined; do
            echo
            echo "--- $cat ---"
            grep -E "Expected" {params.dcards}/limits_${{cat}}.txt || echo "  (no limits found)"
        done
        echo
        echo "============================================================"
        }} | tee {output}
        """


# ── Step 7: Brazil-band plot across all categories ──────────────────────────
rule limit_plot:
    retries: 2
    input:
        nominal  = f"{DCARDS}/limits_nominal.json",
        lowpt    = f"{DCARDS}/limits_lowpt.json",
        incl3j2b = f"{DCARDS}/limits_incl3j2b.json",
        combined = f"{DCARDS}/limits_combined.json",
    output:
        f"{OUT}/plots/limit_plot.png"
    log:
        f"{OUT}/logs/limit_plot.log"
    shell:
        """
        mkdir -p $(dirname {output}) $(dirname {log})
        echo "[$(date)] Building limit plot" > {log}
        # Labels are single tokens (no internal spaces) so they survive shell
        # word-splitting regardless of how run_container wraps the call.
        {config[coffea_wrapper]} python src/plotting/make_limit_plot.py \
            -i {input.combined} {input.incl3j2b} {input.lowpt} {input.nominal} \
            -l "combined" "incl_3j2b" "lowpt_4j2b" "nominal_4j2b" \
            --stat-only \
            -o {output} \
            2>&1 | tee -a {log}
        """


# ── Step 8: FitDiagnostics on the Asimov dataset (blind)  [combine container] ─
# -t -1 --expectSignal 1 fits the Asimov dataset (prefit expectation, r=1), so
# no real data is fit. --saveShapes --saveWithUncertainties stores per-bin
# prefit and postfit templates in fitDiagnostics_<cat>.root.
rule fit_diagnostics:
    retries: 2
    input:
        f"{DCARDS}/datacard_{{cat}}.root"
    output:
        f"{DCARDS}/fitDiagnostics_{{cat}}.root"
    log:
        f"{OUT}/logs/fit_diagnostics_{{cat}}.log"
    params:
        dcards = DCARDS,
    shell:
        """
        mkdir -p $(dirname {log})
        echo "[$(date)] FitDiagnostics (Asimov, expectSignal=1) for {wildcards.cat}" > {log}
        {config[combine_wrapper]} "cd {params.dcards} && \
            combine -M FitDiagnostics datacard_{wildcards.cat}.root \
            -t -1 --expectSignal 1 \
            --saveShapes --saveWithUncertainties \
            -n _{wildcards.cat}" \
            2>&1 | tee -a {log}
        """


# ── Step 9: prefit/postfit shape plots per combine bin  [coffea container] ───
rule prefit_postfit_plots:
    retries: 2
    input:
        f"{DCARDS}/fitDiagnostics_{{cat}}.root"
    output:
        directory(f"{OUT}/plots/prefit_postfit_{{cat}}")
    log:
        f"{OUT}/logs/prefit_postfit_plots_{{cat}}.log"
    shell:
        """
        mkdir -p $(dirname {log}) {output}
        echo "[$(date)] Prefit/postfit plots for {wildcards.cat}" > {log}
        {config[coffea_wrapper]} python src/plotting/make_prefit_postfit_plots.py \
            -i {input} \
            -o {output} \
            --logy --summed \
            2>&1 | tee -a {log}
        """
