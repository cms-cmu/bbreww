"""
bbWW statistical analysis workflow — workspace → limits → summary.

Usage (from barista root):
    ./run_container snakemake --snakefile bbreww/workflows/Snakefile_combine \
        --cores 1 --configfile bbreww/workflows/config_combine.yml

Steps:
    1. convert_coffea_to_json  — .coffea → .json (per category)
    2. make_combine_inputs     — .json → shapes + per-year datacards
    3. workspace + limits      — datacard.txt → AsymptoticLimits per category + combined
    4. summary                 — print all three Brazil bands
    5. fit_diagnostics         — FitDiagnostics on the Asimov dataset (blind)
    6. prefit_postfit_plots    — prefit/postfit stacked shapes per combine bin

The convert and make_combine_inputs steps auto-delete stale JSONs/datacards
to avoid Snakemake skipping them when their content (not their existence)
changed (e.g. config edits).
"""

# ── config defaults (override via --configfile or --config) ──────────────────
config.setdefault("coffea_wrapper",   "./run_container ")          # coffea container
config.setdefault("combine_wrapper",  "./run_container combine ")  # combine container
config.setdefault("output_path",   "output/combine")
config.setdefault("input_coffea",  "output/full_run/output_merged.coffea")
config.setdefault("channel",  "hadronic_W")   # channel axis value
config.setdefault("flavor",   "mu")           # flavor axis value
config.setdefault("rebin",    1)
# Merge 2022+2023 into one template per (channel, flavor), halving the number
# of combine bins. Stat-only only (year-specific shape systs can't apply to a
# year-summed template). Override with --config merge_years=true
config.setdefault("merge_years", False)

# nominal 4j2b category
config.setdefault("nominal_collection",   "hists_4j2b")
config.setdefault("nominal_histos",       "SvB.phh_variable_nominal")
config.setdefault("nominal_variable",     "SvB.phh_variable_nominal")
config.setdefault("nominal_sum_axes",     "region")
config.setdefault("nominal_select_axes",  "nominal_4j2b=True")

# lowpt 4j2b category
config.setdefault("lowpt_collection",     "hists")
config.setdefault("lowpt_histos",         "SvB.phh_variable_lowpt")
config.setdefault("lowpt_variable",       "SvB.phh_variable_lowpt")
config.setdefault("lowpt_sum_axes",       "region")
config.setdefault("lowpt_select_axes",    "lowpt_4j2b=True")

# inclusive 3j2b category
config.setdefault("incl3j2b_collection",   "hists")
config.setdefault("incl3j2b_histos",       "SvB.phh_variable_3j2b")
config.setdefault("incl3j2b_variable",     "SvB.phh_variable_3j2b")
config.setdefault("incl3j2b_sum_axes",     "")
config.setdefault("incl3j2b_select_axes",  "incl_3j2b=True region=SR")

OUT    = config["output_path"]
DCARDS = f"{OUT}/datacards/bbWW"

# ── signal label ──────────────────────────────────────────────────────────────
SIGNALLABEL = "ggHH_kl_1_kt_1_13p6TeV_hbbhww"

def _sum_flag(key):
    val = config.get(key) or ""
    return f"--sum {val}" if val.strip() else ""

def _select_flag(key):
    val = config.get(key) or ""
    return f"--select {val}" if val.strip() else ""

# merge_years may arrive as a bool (default) or a string ("true"/"false") from
# --config merge_years=...; normalise to the make_combine_inputs.py flag string.
def _is_true(val):
    return str(val).strip().lower() in ("true", "1", "yes")

MERGE_YEARS_FLAG = "--merge_years" if _is_true(config.get("merge_years")) else ""

# ── targets ───────────────────────────────────────────────────────────────────
CATEGORIES = ["nominal", "lowpt", "incl3j2b", "combined"]

rule all:
    input:
        f"{OUT}/summary.txt",
        f"{OUT}/plots/limit_plot.png",
        expand(f"{OUT}/plots/prefit_postfit_{{cat}}", cat=CATEGORIES),


# ── Step 1a: coffea → JSON for nominal 4j2b  [coffea container] ──────────────
rule convert_coffea_to_json_nominal:
    retries: 2
    input:
        config["input_coffea"]
    output:
        f"{OUT}/histAll_nominal.json"
    log:
        f"{OUT}/logs/convert_coffea_to_json_nominal.log"
    params:
        sum_flag    = _sum_flag('nominal_sum_axes'),
        select_flag = _select_flag('nominal_select_axes'),
    shell:
        """
        mkdir -p $(dirname {log})
        rm -f {output}
        echo "[$(date)] Starting convert_coffea_to_json_nominal" > {log}
        {config[coffea_wrapper]} python src/tools/convert_coffea_to_json.py \
            -i {input} \
            -o {output} \
            --collection {config[nominal_collection]} \
            --histos {config[nominal_histos]} \
            {params.sum_flag} \
            {params.select_flag} \
            2>&1 | tee -a {log}
        echo "[$(date)] Completed convert_coffea_to_json_nominal" >> {log}
        """


# ── Step 1b: coffea → JSON for lowpt 4j2b  [coffea container] ────────────────
rule convert_coffea_to_json_lowpt:
    retries: 2
    input:
        config["input_coffea"]
    output:
        f"{OUT}/histAll_lowpt.json"
    log:
        f"{OUT}/logs/convert_coffea_to_json_lowpt.log"
    params:
        sum_flag    = _sum_flag('lowpt_sum_axes'),
        select_flag = _select_flag('lowpt_select_axes'),
    shell:
        """
        mkdir -p $(dirname {log})
        rm -f {output}
        echo "[$(date)] Starting convert_coffea_to_json_lowpt" > {log}
        {config[coffea_wrapper]} python src/tools/convert_coffea_to_json.py \
            -i {input} \
            -o {output} \
            --collection {config[lowpt_collection]} \
            --histos {config[lowpt_histos]} \
            {params.sum_flag} \
            {params.select_flag} \
            2>&1 | tee -a {log}
        echo "[$(date)] Completed convert_coffea_to_json_lowpt" >> {log}
        """


# ── Step 1c: coffea → JSON for inclusive 3j2b  [coffea container] ────────────
rule convert_coffea_to_json_incl3j2b:
    retries: 2
    input:
        config["input_coffea"]
    output:
        f"{OUT}/histAll_incl3j2b.json"
    log:
        f"{OUT}/logs/convert_coffea_to_json_incl3j2b.log"
    params:
        sum_flag    = _sum_flag('incl3j2b_sum_axes'),
        select_flag = _select_flag('incl3j2b_select_axes'),
    shell:
