        mkdir -p $(dirname {log})
        rm -f {output}
        echo "[$(date)] Starting convert_coffea_to_json_incl3j2b" > {log}
        {config[coffea_wrapper]} python src/tools/convert_coffea_to_json.py \
            -i {input} \
            -o {output} \
            --collection {config[incl3j2b_collection]} \
            --histos {config[incl3j2b_histos]} \
